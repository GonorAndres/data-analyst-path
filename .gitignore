# Python
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# R
.Rhistory
.RData
.Rproj.user/

# Data files (large)
*.csv
*.xlsx
*.parquet
*.json
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
# Next.js project files — always track
!package.json
!package-lock.json
!tsconfig.json
# Static JSON data for portfolio dashboards. These are build *inputs*, not
# artifacts: the dashboards fetch them at runtime and CI never regenerates them
# (the parquet they come from lives in GCS and is pulled for the API).
# Left to the `*.json` rule above they are silently skipped by
# `git add`, the local build looks fine, and CI publishes a dashboard with no data.
!projects/00-demo-aestehtics/public/data/**/*.json
!projects/02-ecommerce-cohort-analysis/web/public/cohorts/data/*.json
!apps/web/src/features/cohorts/data/*.json
!projects/01-insurance-claims-dashboard/public/insurance/evidence/*.json
!projects/04-executive-kpi-report/public/kpi/evidence/*.json
!apps/web/src/lib/evidence-snapshots.json

# Power BI temp files
*.pbix.tmp

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Subagent outputs
subagents_outputs/

# Secrets
.env
*.env
.env.*
!.env.example
credentials.json
*.pem
*.key

# Node / Next.js build artifacts
node_modules/
.next/
.next-dev/
next-env.d.ts
tsconfig.tsbuildinfo

# Static exports and the Cloudflare Pages tree. The sole apps/web frontend
# exports out/; scripts/build-hub.mjs stages dist/. Track sources, not outputs.
# Ignore any accidentally regenerated legacy exports as well.
projects/*/out/
projects/*/*/out/
/dist/
/apps/web/out/
/apps/web/public/*
# The unified frontend serves these checked-in responsive illustrations. Keep
# the rest of public/ available for local/generated files without tracking it.
!/apps/web/public/images/
!/apps/web/public/images/cases/
/apps/web/public/images/*
!/apps/web/public/images/cases/*-v2-*.webp
!/apps/web/public/images/making-sense-*.webp
.wrangler/

# Playwright failure artifacts (screenshots, traces) -- written only when a spec
# fails, so the directory looks empty until it matters.
test-results/

# Playwright MCP logs
.playwright-mcp/

# Ad-hoc screenshots (root + projects/)
/*.png
projects/*.png

# Data caches (yfinance etc.)
**/data/cache/

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.toc

# Personal / ephemeral
to-do.md
