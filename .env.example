# Copy this file to .env and fill in your values
# .env is gitignored and will never be pushed to the repository

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Power BI Service (optional)
PBI_WORKSPACE_ID=
PBI_REPORT_ID=

# Unified frontend development proxy (set in apps/web/.env.local if overriding)
API_ORIGIN=http://localhost:8080

# API keys (optional)
ALPHA_VANTAGE_API_KEY=
