# Replaces the retired Streamlit dashboard with a permanent redirect.
#
# The service itself has to stay: deleting it would make the run.app URL 404,
# and that URL was linked from gonor.me and the blog for months. A 308 keeps
# every one of those links working and hands the ranking to the canonical path.
server {
    listen       ${PORT};
    listen       [::]:${PORT};
    server_name  _;

    # 308, not 301: it preserves the method, and it is what the six retired
    # Vercel dashboards already answer, so every retired host behaves alike.
    #
    # Everything lands on the dashboard root rather than preserving the path.
    # Streamlit's own routes (/Retencion_por_Cohortes, ?page=...) have no
    # counterpart in the rebuild, so carrying the path over would turn a working
    # old link into a 404 on the new site -- worse than the redirect it replaces.
    location / {
        return 308 https://data-analyst.gonor.me/cohorts/;
    }

    # Cloud Run's startup probe needs an answer that is not a redirect.
    location = /_stcore/health {
        add_header Content-Type text/plain;
        return 200 'redirect-only: see https://data-analyst.gonor.me/cohorts/';
    }
}
